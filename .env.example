# ============================================================
# Personal LLM — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git — it is excluded via .gitignore
#
# Priority: shell env vars > .env file > defaults in src/config.py
# ============================================================

# ─── Model Configuration ─────────────────────────────────────
# HuggingFace model ID for the base model
BASE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# Path to saved LoRA adapter weights after training
ADAPTER_PATH=./output/final

# Load model into memory at server startup (true) or on first request (false)
PRELOAD_MODEL=false

# ─── Server ──────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Environment: "development" (shows docs) or "production" (hides docs)
# ENVIRONMENT=development

# ─── API Security ────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API key for endpoint authentication (leave commented to disable)
# API_KEY=your-secret-api-key-here

# Requests per minute per IP for inference endpoints
# RATE_LIMIT=10/minute

# ─── HuggingFace (optional) ──────────────────────────────────
# Required only for gated/private models (e.g. LLaMA 2, Gemma).
# Generate at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Weights & Biases (optional) ─────────────────────────────
# Uncomment to enable experiment tracking during training.
# WANDB_API_KEY=your-wandb-key-here
# WANDB_PROJECT=personal-llm

# ─── Paths (optional) ────────────────────────────────────────
# OUTPUT_DIR=./output
# LOGGING_DIR=./logs
# CONFIG_PATH=config/training_config.yaml
